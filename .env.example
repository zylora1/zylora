# Runtime environment: development | test | staging | production
ENVIRONMENT=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL 18. Use postgresql+psycopg for SQLAlchemy and plain postgresql for Alembic/psycopg.
DATABASE_URL=postgresql+psycopg://zylora:zylora_dev_only@localhost:5432/zylora
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379/0

# Browser-exposed values must be explicitly prefixed and contain no secrets.
# Canonical public origin. Search indexing remains disabled unless explicitly enabled in production.
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SEARCH_INDEXING_ENABLED=false
API_INTERNAL_URL=http://127.0.0.1:8000
WEB_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,admin.localhost
TRUSTED_PROXY_IPS=
# Trust CF-IPCountry only when production origin access is restricted to Cloudflare.
CLOUDFLARE_COUNTRY_HEADER_TRUSTED=false

# Phase 8 publishing and verified domains. Keep all Cloudflare values server-side.
# Production requires DOMAIN_PROVIDER=cloudflare and a private, least-privilege API token.
DOMAIN_PROVIDER=disabled
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PUBLISHED_ORIGIN=
PUBLISHED_SITE_BASE_DOMAIN=sites.zylora.local
CLOUDFLARE_API_TIMEOUT_SECONDS=5

# S3-compatible object storage. Local development uses the pinned MinIO service.
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zylora-development
S3_ACCESS_KEY=zylora_dev_only
S3_SECRET_KEY=zylora_dev_only_secret
S3_FORCE_PATH_STYLE=true

# Authentication. Replace every secret and provider credential outside development.
AUTH_SECRET=zylora_development_auth_secret_change_me
COOKIE_SECURE=false
ADMIN_ORIGIN=http://admin.localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_START_TLS=false
SMTP_FROM_EMAIL=no-reply@zylora.local
# Destination for public Zylora contact submissions; required in production.
CONTACT_RECIPIENT_EMAIL=

# Cloudflare Turnstile. These documented values are Cloudflare public test keys and must never be used in production.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,admin.localhost,example.com
TURNSTILE_TIMEOUT_SECONDS=5
CHATBOT_CHUNK_CHARACTERS=900

# Phase 6 AI editing. Keep OPENAI_API_KEY server-side; never prefix it with NEXT_PUBLIC_.
# Development fails closed until a real provider credential is configured.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4000
# Phase 10 FAISS chatbot embeddings. Keep the API key above server-side.
CHATBOT_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_EMBEDDING_DIMENSION=1536
CHATBOT_GENERATION_MODEL=gpt-5.6-terra
CHATBOT_RETRIEVAL_LIMIT=4
CHATBOT_RELEVANCE_THRESHOLD=0.2
CHATBOT_MAX_CONTEXT_CHARACTERS=12000
KNOWLEDGE_INGESTION_ENABLED=false
KNOWLEDGE_MAX_FILE_BYTES=15728640
KNOWLEDGE_MAX_DOCUMENTS_PER_WEBSITE=25
KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=500000
KNOWLEDGE_MAX_PDF_PAGES=300
KNOWLEDGE_MAX_DOCX_ENTRIES=2000
KNOWLEDGE_MAX_DOCX_UNCOMPRESSED_BYTES=52428800
DOCUMENT_SCANNER_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20

# Twilio WhatsApp is fail-closed until sender onboarding and Content Templates are approved.
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_LEAD_TEMPLATE_CONTENT_SID=
TWILIO_TEST_TEMPLATE_CONTENT_SID=
TWILIO_STATUS_CALLBACK_BASE_URL=
TWILIO_TIMEOUT_SECONDS=10


# Worker configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WORKER_CONCURRENCY=2
CELERY_VISIBILITY_TIMEOUT_SECONDS=900
CELERY_SOFT_TIME_LIMIT_SECONDS=270
CELERY_TIME_LIMIT_SECONDS=300
AI_GENERATION_SOFT_TIME_LIMIT_SECONDS=570
AI_GENERATION_TIME_LIMIT_SECONDS=600
CELERY_PREFETCH_MULTIPLIER=1
CELERY_MAX_TASKS_PER_CHILD=50

# Production rejects development credentials, localhost origins, and test storage adapters.

# Isolated AI Next.js builder (Core remains disabled until every dependency is ready)
AI_BUILDER_ENABLED=false
AI_BUILDER_ROLLOUT_MODE=canary
# Comma-separated User UUIDs. Required when staging/production canary generation is enabled.
AI_BUILDER_CANARY_USER_IDS=
# Dedicated hostile-content preview origin; must not share application cookies.
AI_BUILDER_PREVIEW_ORIGIN=
AI_BUILDER_URL=http://127.0.0.1:8090
AI_BUILDER_SERVICE_TOKEN=
AI_BUILDER_CONNECT_TIMEOUT_SECONDS=5
AI_GENERATION_TIMEOUT_SECONDS=420
MAX_AI_PROMPT_BYTES=8192
AI_BUILDER_MAX_OUTPUT_TOKENS=32000
MAX_ACTIVE_AI_JOBS_PER_USER=2
MAX_AI_GENERATIONS_PER_WINDOW=10
AI_GENERATION_WINDOW_SECONDS=3600
AI_MAX_RETRIES=4
AI_JOB_LEASE_SECONDS=600
AI_MAX_ARTIFACT_BYTES=52428800
AI_ARTIFACT_URL_TTL_SECONDS=300

# Variables below belong only to the isolated zylora-ai-builder runtime.
AI_BUILDER_ENVIRONMENT=development
AI_BUILDER_PROVIDER_URL=
AI_BUILDER_PROVIDER_TOKEN=
AI_BUILDER_PROVIDER_NAME=
AI_BUILDER_PROVIDER_MODEL=
AI_PROVIDER_TIMEOUT_SECONDS=120
AI_PROVIDER_HTTP_RETRIES=2
MAX_AI_OUTPUT_TOKENS=32000
MAX_AI_PROVIDER_RESPONSE_BYTES=3500000
AI_BUILDER_SANDBOX_URL=
AI_BUILDER_SANDBOX_TOKEN=
AI_SANDBOX_TIMEOUT_SECONDS=240
MAX_AI_ARTIFACT_BYTES=52428800
